{
  "version": "0.1",
  "title": "家庭成员登记",
  "description": "演示动态增删行:array 字段每行按 columns 渲染,逐行校验",
  "fields": [
    {
      "key": "ownerName",
      "label": "登记人",
      "type": "string",
      "validation": { "required": true }
    },
    {
      "key": "familyMembers",
      "label": "家庭成员",
      "type": "array",
      "validation": { "required": true },
      "columns": [
        {
          "key": "name",
          "label": "姓名",
          "type": "string",
          "validation": { "required": true, "minLength": 2 }
        },
        {
          "key": "relationship",
          "label": "关系",
          "type": "select",
          "options": [
            { "label": "配偶", "value": "spouse" },
            { "label": "子女", "value": "child" },
            { "label": "父母", "value": "parent" }
          ],
          "validation": { "required": true }
        },
        {
          "key": "age",
          "label": "年龄",
          "type": "number",
          "validation": { "required": true, "min": 0, "max": 150 }
        }
      ]
    }
  ]
}
